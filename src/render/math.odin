package render

// Miscellaneous types used throughout the rendering code

int2 :: [2]i32
int3 :: [3]i32
int4 :: [4]i32
int2x2 :: matrix[2, 2]i32
int3x3 :: matrix[3, 3]i32
int4x4 :: matrix[4, 4]i32

uint2 :: [2]u32
uint3 :: [3]u32
uint4 :: [4]u32
uint2x2 :: matrix[2, 2]u32
uint3x3 :: matrix[3, 3]u32
uint4x4 :: matrix[4, 4]u32

float2 :: [2]f32
float3 :: [3]f32
float4 :: [4]f32
float2x2 :: matrix[2, 2]f32
float3x3 :: matrix[3, 3]f32
float4x4 :: matrix[4, 4]f32
